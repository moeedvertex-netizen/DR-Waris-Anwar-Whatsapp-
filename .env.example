# ============================================================
# DR. WARIS ANWAR AESTHETICS - ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# In Railway: Add these in Settings > Variables
# ============================================================

# WhatsApp Cloud API (from Meta Developer Console)
WHATSAPP_TOKEN=your_permanent_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=drwaris_verify_token_2026

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (from supabase.com > Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Google Calendar (optional - for appointment sync)
GOOGLE_CALENDAR_ID=drwarisanwar@gmail.com
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
