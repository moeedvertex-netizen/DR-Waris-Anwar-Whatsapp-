# ============================================================
# DR. WARIS ANWAR AESTHETICS - ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# In Railway: Add these in Settings > Variables
# ============================================================

# WhatsApp Cloud API (from Meta Developer Console)
WHATSAPP_TOKEN=your_whatsapp_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=your_verify_token_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter AI (optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Choose AI Provider: 'gemini' or 'openrouter'
AI_PROVIDER=gemini
# Supabase (from supabase.com > Settings > API)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your supabase_key_here
# Google Calendar (optional - for appointment sync)
GOOGLE_CALENDAR_ID=your_google_calendar_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=PASTE_JSON_HERE
